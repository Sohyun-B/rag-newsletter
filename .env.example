# ===========================================
# Newsletter RAG System - 환경변수 설정
# ===========================================
# 이 파일을 복사하여 .env 파일로 저장하고 실제 값을 입력하세요.
# cp .env.example .env

# -------------------------------------------
# MSSQL 데이터베이스 (필수)
# -------------------------------------------
# 직접 연결 예시 (온프레미스 또는 원격 서버)
MSSQL_SERVER=192.168.1.100,1433
# 또는 hostname 사용: MSSQL_SERVER=your-db-server.local,1433
# 또는 localhost: MSSQL_SERVER=localhost,1433
# 포트 기본값은 1433, 다른 포트 사용 시 콤마로 구분

MSSQL_DATABASE=project_pm
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrongPassword123!

# -------------------------------------------
# OpenAI API (필수 - 임베딩용)
# -------------------------------------------
# text-embedding-3-small 모델 사용
# API 키 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------------------------
# Anthropic API (필수 - Claude LLM용)
# -------------------------------------------
# Claude를 사용한 RAG 답변 생성
# API 키 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------------------------
# Gmail 설정 (선택 - 기본값 있음)
# -------------------------------------------
# OAuth 토큰 파일 경로 (Docker 내부 경로)
# GMAIL_TOKEN_PATH=./gmail/token.json

# OAuth 자격증명 파일 경로 (Docker 내부 경로)
# GMAIL_CREDENTIALS_PATH=./gmail/credentials.json

# -------------------------------------------
# Chroma 벡터DB 설정 (선택 - 기본값 있음)
# -------------------------------------------
# 벡터 데이터 저장 경로 (Docker 볼륨으로 마운트됨)
# CHROMA_PATH=./chroma_data

# -------------------------------------------
# 스케줄러 설정 (선택 - 기본값 있음)
# -------------------------------------------
# Gmail 동기화 주기 (분 단위, 기본값: 5)
# SYNC_INTERVAL_MINUTES=5
